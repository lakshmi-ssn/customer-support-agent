# Copy this file to .env and fill in your key. .env is gitignored; never commit it.
#
#   cp .env.example .env
#
# If pip refused to install gradio, your Python is 3.9. HW2 needs 3.10+ —
# run `python scripts/check_env.py`.

OPENROUTER_API_KEY=your_key_here

# Optional overrides — anything in support_agent/config.py can be set here.
# TOOL_MODEL=openai/gpt-4o-mini
# FAST_MODEL=meta-llama/llama-3.1-8b-instruct
# RETRIEVAL_MODE=dense
# TOP_K=4
